# AI Product Studio - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env files with real credentials to git!

# OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
# This will be stored securely in Windows Credential Manager in the desktop app
OPENROUTER_API_KEY=

# Optional: Custom API endpoint (leave empty for default)
OPENROUTER_BASE_URL=

# Optional: Default model preferences
# DEFAULT_TEXT_MODEL=openai/gpt-4o-mini
# DEFAULT_VISION_MODEL=openai/gpt-4o
# DEFAULT_IMAGE_MODEL=openai/dall-e-3
